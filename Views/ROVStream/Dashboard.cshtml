@model mark_vnil._1.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="max-w-6xl mx-auto px-4 sm:px-6 py-10">

    <!-- Status Header -->
    <div class="mb-10 flex items-center gap-3">
        <span id="liveIndicator" class="hidden w-3 h-3 rounded-full bg-red-500 animate-pulse"></span>
        <span id="offlineIndicator" class="w-3 h-3 rounded-full bg-zinc-600"></span>
        <p id="currentStreamingStatus" class="text-xl font-medium text-white tracking-tight">Currently not streaming</p>
    </div>

    <!-- Live Section -->
    <div id="liveSection" class="hidden mb-16">
        <div class="w-full rounded-2xl overflow-hidden border border-zinc-800 mb-6 bg-zinc-950">
            <img id="liveStreamFeed" class="w-full object-cover" src="" alt="Live Feed">
        </div>

        <h2 class="text-sm font-medium text-zinc-500 uppercase tracking-wider mb-3">Detected Items</h2>
        <ul id="detectedItemsChecklist" class="flex flex-wrap gap-x-6 gap-y-2 mb-8"></ul>

        <ul id="detectedItemsList" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3"></ul>
    </div>

    <!-- Divider -->
    <div class="border-t border-zinc-900 mb-10"></div>

    <!-- Past Streams -->
    <div>
        <h2 class="text-sm font-medium text-zinc-500 uppercase tracking-wider mb-6">Past Streams</h2>

        <div id="pastStreamsList" class="flex flex-col gap-8">
            @foreach (var stream in Model.AllStreams)
            {
                var items = stream.ROVDetectedItems!.ToList();
                <div class="stream-card bg-zinc-950 border border-zinc-800 rounded-2xl p-5 sm:p-8">
                    <div class="mb-6">
                        <h3 class="text-white font-medium text-base tracking-tight">@stream.Title</h3>
                        <p class="text-zinc-600 text-sm mt-1">@stream.StartTimeStamp.ToString("MMM dd, yyyy HH:mm") — @stream.EndTimeStamp?.ToString("MMM dd, yyyy HH:mm")</p>
                    </div>
                    <div class="flex flex-col lg:flex-row gap-6 lg:gap-8">
                        <div class="w-full lg:w-1/2 shrink-0">
                            <video src="@stream.RecordedFileUrl" controls class="w-full rounded-xl border border-zinc-800 bg-black"></video>
                        </div>
                        <div class="w-full lg:w-1/2 flex flex-col gap-5 items-center">
                            <div class="snapshot-grid flex justify-center w-full" data-stream-id="@stream.Id" data-count="@items.Count">
                                @{
                                    var shown = items.Count >= 4 ? items.Take(3).ToList() : items;
                                    var remaining = items.Count - shown.Count;
                                    var gridClass = items.Count switch
                                    {
                                        0 => "hidden",
                                        1 => "grid grid-cols-1 w-full max-w-[9.5rem]",
                                        2 => "grid grid-cols-2 gap-2 w-full max-w-xs",
                                        _ => "grid grid-cols-2 gap-2 w-full max-w-xs"
                                    };
                                }
                                <div class="@gridClass">
                                    @for (int i = 0; i < shown.Count; i++)
                                    {
                                        var item = shown[i];
                                        var isLastOfThree = items.Count == 3 && i == 2;
                                        <img src="@item.SnapshotFileUrl" alt="@item.Label"
                                             class="snapshot-thumb w-full @(isLastOfThree ? "aspect-[2/1] col-span-2" : "aspect-square") object-cover rounded-lg border border-zinc-800 cursor-pointer hover:opacity-80 transition"
                                             data-stream-id="@stream.Id">
                                    }
                                    @if (remaining > 0)
                                    {
                                        <div class="snapshot-thumb w-full aspect-square rounded-lg border border-zinc-800 bg-zinc-900 flex items-center justify-center text-zinc-500 text-sm font-medium cursor-pointer hover:opacity-80 transition overflow-hidden px-1 leading-none"
                                             data-stream-id="@stream.Id">
                                            +@remaining
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="overflow-y-auto max-h-40 w-full">
                                @if (items.Any())
                                {
                                    <ul class="flex flex-col gap-2 items-center text-center">
                                        @foreach (var item in items)
                                        {
                                            <li class="text-base">
                                                <span class="text-white font-semibold">@item.Label</span>
                                                <span class="text-zinc-500 text-sm"> — @item.DetectedAtTimeStamp.ToString("HH:mm:ss")</span>
                                            </li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <p class="text-zinc-700 text-sm">No detections for this stream.</p>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- store snapshot URLs for modal use -->
                    <script type="application/json" class="snapshot-data" data-stream-id="@stream.Id">
                        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(items.Select(i => new { i.SnapshotFileUrl, i.Label })))
                    </script>
                </div>
            }
        </div>
    </div>
</div>

<!-- Snapshot Modal -->
<div id="snapshotModal" class="hidden fixed inset-0 bg-black/90 z-50 flex items-center justify-center p-4 sm:p-8">
    <button id="snapshotModalClose" class="absolute top-4 right-4 sm:top-6 sm:right-6 text-zinc-400 hover:text-white text-2xl">&times;</button>
    <div id="snapshotModalGrid" class="grid grid-cols-2 sm:grid-cols-3 gap-3 max-w-4xl max-h-[80vh] overflow-y-auto w-fit mx-auto"></div>
</div>